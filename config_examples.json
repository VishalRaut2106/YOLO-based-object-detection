{
  "cpu_optimized": {
    "description": "Optimized for CPU-only systems - faster processing with lower accuracy",
    "detection": {
      "confidence_threshold": 0.5,
      "nms_threshold": 0.4,
      "input_resolution": 320,
      "backend": "opencv",
      "target": "cpu"
    },
    "performance": {
      "frame_queue_size": 2,
      "enable_profiling": false,
      "log_interval_seconds": 10
    },
    "snapshot": {
      "directory": "snapshots",
      "jpeg_quality": 85,
      "include_bounding_boxes": true
    }
  },
  
  "gpu_optimized": {
    "description": "Optimized for GPU systems - higher accuracy with CUDA acceleration",
    "detection": {
      "confidence_threshold": 0.5,
      "nms_threshold": 0.4,
      "input_resolution": 416,
      "backend": "cuda",
      "target": "cuda"
    },
    "performance": {
      "frame_queue_size": 3,
      "enable_profiling": false,
      "log_interval_seconds": 10
    },
    "snapshot": {
      "directory": "snapshots",
      "jpeg_quality": 90,
      "include_bounding_boxes": true
    }
  },
  
  "high_accuracy": {
    "description": "Maximum accuracy mode - slower but more precise detections",
