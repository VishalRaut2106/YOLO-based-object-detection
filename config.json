{
  "detection": {
    "confidence_threshold": 0.5,
    "nms_threshold": 0.4,
    "input_resolution": 416,
    "backend": "opencv",
    "target": "cpu"
  },
  "performance": {
    "frame_queue_size": 3,
    "enable_profiling": false,
    "log_interval_seconds": 10
  },
  "ai_description": {
    "provider": "gemini",
    "model": "gemini-2.0-flash",
    "timeout_seconds": 10,
    "max_retries": 2,
    "cache_enabled": true
  },
  "snapshot": {
    "directory": "snapshots",
    "jpeg_quality": 85,
    "include_bounding_boxes": true
  }
}